NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:3000

# Required.
MONGODB_URI=mongodb://127.0.0.1:27017/insightprep

# Required. Must be at least 16 characters.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Required for kit generation (POST /api/kits/:kitId/generate). Other
# endpoints work without it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_MS=20000
GEMINI_MAX_RETRIES=2

# Company-research crawler limits. All optional; sensible defaults apply.
CRAWLER_MAX_PAGES=6
CRAWLER_MAX_DEPTH=2
CRAWLER_MAX_RESPONSE_BYTES=2000000
CRAWLER_TIMEOUT_MS=8000
CRAWLER_MAX_RETRIES=2
CRAWLER_REQUEST_DELAY_MS=300

# Set to "true" only for local/evaluator use with a localhost test server.
# Must stay unset/false in production — see README SSRF protection notes.
ALLOW_LOCAL_RESEARCH_TARGETS=false
